APP_TIMEZONE=America/Bogota
FRONTEND_PORT=8080
INGESTION_PORT=8080
SCORING_PORT=8080
SCORING_BASE_URL=http://scoring:8080
SCORING_TIMEOUT_MS=750
SCORING_CRITERIA_VERSION=SCORING-MVP-1.0.0
AUTH_MODE=development
AUTH_ISSUER=http://dev-auth:8080
AUTH_AUDIENCE=alternative-credit-scoring
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=alternative_scoring
DATABASE_USER=scoring_app
RETENTION_DATABASE_USER=scoring_retention_job
DATABASE_SSL_MODE=disable
LOG_LEVEL=info

# Terms and conditions bounded context. These are local-only, non-sensitive examples.
# Every secret is consumed from a dedicated file; no credential value belongs here.
TERMS_WEB_PORT=8080
TERMS_API_PORT=8080
TERMS_WEB_BASE_HREF=/terms/
TERMS_API_BASE_URL=/terms-api
TERMS_INTERNAL_BASE_URL=http://terms-api:8080
TERMS_INTERNAL_TIMEOUT_MS=500
TERMS_DATABASE_HOST=postgres
TERMS_DATABASE_PORT=5432
TERMS_DATABASE_NAME=terms_local_example
TERMS_DATABASE_USER=terms_app_example
TERMS_MIGRATOR_DATABASE_USER=terms_migrator_example
TERMS_RETENTION_DATABASE_USER=terms_retention_example
TERMS_BACKUP_DATABASE_USER=terms_backup_example
TERMS_DATABASE_SSL_MODE=disable
TERMS_AUTH_ISSUER=http://dev-auth:8080
TERMS_AUTH_JWKS_URL=http://dev-auth:8080/.well-known/jwks.json
TERMS_AUTH_AUDIENCE=alternative-credit-scoring
TERMS_AUTH_ALGORITHMS=RS256
TERMS_OIDC_CLIENT_ID=terms-web-local-example
TERMS_OIDC_SCOPE="openid profile"
TERMS_RETENTION_BATCH_SIZE=500
TERMS_RETENTION_SCHEDULE="30 2 * * *"

# Example mount paths only. See terms-secrets.example for the separated filename contract.
TERMS_DATABASE_PASSWORD_FILE=/run/secrets/example_terms_runtime_database_password
TERMS_MIGRATOR_DATABASE_PASSWORD_FILE=/run/secrets/example_terms_migrator_database_password
TERMS_RETENTION_DATABASE_PASSWORD_FILE=/run/secrets/example_terms_retention_database_password
TERMS_BACKUP_DATABASE_PASSWORD_FILE=/run/secrets/example_terms_backup_database_password
TERMS_INTERNAL_SERVICE_TOKEN_FILE=/run/secrets/example_terms_internal_service_token
TERMS_DATABASE_CA_FILE=/run/secrets/example_terms_database_ca
TERMS_FINGERPRINT_KEY_FILE=/run/secrets/example_terms_fingerprint_key
