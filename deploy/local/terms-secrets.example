# Filename/reference inventory only. This file intentionally contains no secret values.
# Copy the naming contract into the local secret generator; do not source this file as
# credentials and do not commit files created under deploy/local/.secrets/.

TERMS_RUNTIME_SECRET_REF=example-terms-runtime
TERMS_RUNTIME_DATABASE_PASSWORD_FILENAME=example-terms-runtime-database-password
TERMS_INTERNAL_SERVICE_TOKEN_FILENAME=example-terms-internal-service-token

TERMS_MIGRATOR_SECRET_REF=example-terms-migrator
TERMS_MIGRATOR_DATABASE_PASSWORD_FILENAME=example-terms-migrator-database-password

TERMS_RETENTION_SECRET_REF=example-terms-retention
TERMS_RETENTION_DATABASE_PASSWORD_FILENAME=example-terms-retention-database-password

TERMS_BACKUP_SECRET_REF=example-terms-backup
TERMS_BACKUP_DATABASE_PASSWORD_FILENAME=example-terms-backup-database-password

TERMS_DATABASE_TLS_SECRET_REF=example-terms-database-tls
TERMS_DATABASE_CA_FILENAME=example-terms-database-ca.crt

# Optional until fingerprinting is enabled by an approved design decision.
TERMS_KEYRING_SECRET_REF=example-terms-keyring
TERMS_FINGERPRINT_KEY_FILENAME=example-terms-fingerprint-key-v1
